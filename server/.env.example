# ---- Server ----
PORT=5000

# Comma-separated list of allowed frontend origins (CORS).
# Local dev default shown; add your deployed frontend URL in production.
CLIENT_ORIGIN=http://localhost:5173

# ---- Email (Nodemailer / SMTP) ----
# For Gmail, create an App Password (requires 2FA) and use it as SMTP_PASS.
# Without these set, the contact endpoint runs in dev mode and only logs.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Where contact submissions are delivered.
CONTACT_TO=jesryljade18@gmail.com
